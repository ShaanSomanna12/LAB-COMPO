{
  "mcpServers": {
    "gsd": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp"],
      "env": {
        "SUPABASE_PROJECT_REF": "<YOUR_SUPABASE_PROJECT_REF>",
        "SUPABASE_ACCESS_TOKEN": "<YOUR_SUPABASE_ACCESS_TOKEN>"
      }
    }
  }
}
